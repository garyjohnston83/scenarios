{
  "name": "scenarios-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env ENV=local concurrently -p none \"webpack serve --mode development\" \"npm run start:server\"",
    "dev": "cross-env ENV=dev webpack serve --mode development",
    "build": "webpack --mode production",
    "playwright:install": "npx playwright install chromium",
    "playwright:open:ui:mode": "npx bddgen && cross-env ENV=local npx playwright test --ui",
    "playwright:run:all:tests": "npx bddgen && cross-env ENV=local npx playwright test",
    "playwright:acceptance:tests": "npx bddgen --tags @acceptance && cross-env ENV=local npx playwright test",
    "dev:regression:tests": "npx bddgen --tags @regression && cross-env ENV=dev npx playwright test",
    "dev:integration:tests": "npx bddgen --tags @integration && cross-env ENV=dev npx playwright test",
    "start:server": "nodemon ./stub/server.js",
    "test": "jest",
    "test:watch": "jest --watch --coverage",
    "test:coverage": "jest --coverage",
    "test:coverage:ci": "jest --ci --watchAll=false",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fluentui/react-components": "^9.72.8",
    "@fluentui/react-datepicker-compat": "^0.6.22",
    "@fluentui/react-icons": "^2.0.302",
    "@reduxjs/toolkit": "^2.8.2",
    "@testing-library/dom": "^10.4.1",
    "@types/uuid": "^10.0.0",
    "axios": "^1.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-redux": "^9.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.6.2",
    "redux-saga": "^1.2.3",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.55.1",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.1",
