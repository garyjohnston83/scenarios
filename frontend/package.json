    "eslint-plugin-storybook": "^0.11.0",
    "eslint-webpack-plugin": "^5.0.2",
    "express": "^5.1.0",
    "fork-ts-checker-webpack-plugin": "^9.0.0",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
