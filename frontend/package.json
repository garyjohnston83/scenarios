    "webpack-dev-server": "^5.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.6.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
